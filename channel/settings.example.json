{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": [
              "__G2CC_ROOT__/channel/hook.ts"
            ],
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": [
              "__G2CC_ROOT__/channel/hook.ts"
            ],
            "timeout": 3
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": [
              "__G2CC_ROOT__/channel/hook.ts"
            ],
            "timeout": 3
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": [
              "__G2CC_ROOT__/channel/hook.ts"
            ],
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": [
              "__G2CC_ROOT__/channel/hook.ts"
            ],
            "timeout": 3
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "mcp__g2__ask",
      "mcp__g2__glance"
    ]
  }
}
