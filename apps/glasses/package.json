{
  "name": "@g2cc/glasses",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build && bun scripts/check-bundle.ts",
    "preview": "vite preview",
    "simulate": "evenhub-simulator http://127.0.0.1:5173 --automation-port 9898",
    "test": "bun test",
    "test:sim": "G2CC_SIM=1 bun test test/sim.e2e.test.ts",
    "pack:launcher": "mkdir -p ../../build && evenhub pack app.json launcher -o ../../build/g2-claude-launcher.ehpk",
    "pack:bundled": "rm -rf ../../build/bundled && G2CC_APP_BASE=./ G2CC_OUT_DIR=../../build/bundled vite build && evenhub pack app.json ../../build/bundled -o ../../build/g2-claude-bundled.ehpk",
    "pack": "bun run pack:launcher && bun run pack:bundled"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.16",
    "@evenrealities/pretext": "^0.1.4",
    "@g2cc/protocol": "workspace:*"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.1.14",
    "@evenrealities/evenhub-simulator": "^0.9.5",
    "@types/bun": "^1.3.10",
    "typescript": "^5.7.0",
    "vite": "^5.4.0",
    "pngjs": "^7.0.0",
    "@types/pngjs": "^6.0.5"
  }
}
